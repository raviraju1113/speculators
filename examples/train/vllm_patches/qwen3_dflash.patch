+def _resolve_layer_rope(config: Qwen3Config, layer_idx: int) -> dict:
+    """RoPE parameters for one draft layer.
+
+    ``rope_parameters`` is either one flat dict shared by every layer (the
+    usual case) or, Transformers-v5 style, a dict keyed by layer type, e.g.
+    ``{"full_attention": {yarn...}, "sliding_attention": {default...}}``.
+    The nested form lets a mixed sliding/full draft scale RoPE only on its
+    full-attention layers (serve-time YaRN) while the sliding layers keep the
+    encoding they were trained with.
+    """
+    rope_parameters = config.rope_parameters
+    if not is_rope_parameters_nested(rope_parameters):
+        return rope_parameters
+    layer_types = getattr(config, "layer_types", None)
+    layer_type = layer_types[layer_idx] if layer_types else "full_attention"
+    if layer_type not in rope_parameters:
+        raise ValueError(
+            f"rope_parameters is keyed by layer type {sorted(rope_parameters)} "
+            f"but draft layer {layer_idx} has layer_type {layer_type!r}"
+        )
+    return rope_parameters[layer_type]
+
+
+def _set_default_rope_theta_per_layer_type(
+    config: Qwen3Config, default_theta: float
+) -> None:
+    """``set_default_rope_theta`` that understands the per-layer-type form."""
+    rope_parameters = getattr(config, "rope_parameters", None)
+    if rope_parameters and is_rope_parameters_nested(rope_parameters):
+        for rp in rope_parameters.values():
+            rp.setdefault("rope_type", "default")
+            rp.setdefault("rope_theta", default_theta)
+        return
+    set_default_rope_theta(config, default_theta=default_theta)
+
