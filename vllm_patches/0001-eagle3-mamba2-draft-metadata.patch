+class _DraftRecurrentAttnMetadata(ModelSpecificAttnMetadata):
+    """Supplies ``is_prefilling`` for a draft model with recurrent (Mamba) layers.
+
+    ``is_prefilling`` normally comes from ``MambaHybridModelState``, which is only
+    selected when the *target* model is hybrid. When the recurrent layers belong to
+    the *draft* instead, the drafting loop is the only thing that knows whether a step
+    extends the state by several tokens or advances it by exactly one, so it supplies
+    the flag itself.
+    """
+
+    def __init__(self, is_prefilling: torch.Tensor):
+        self.is_prefilling = is_prefilling
+
+    def get_extra_common_attn_kwargs(
+        self, kv_cache_group_id: int, num_reqs: int
+    ) -> dict[str, Any]:
+        return {"is_prefilling": self.is_prefilling[:num_reqs]}
