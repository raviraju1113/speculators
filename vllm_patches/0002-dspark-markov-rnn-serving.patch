+    def _prime_markov_state(
+        self,
+        state: torch.Tensor,
+        anchor_tokens: torch.Tensor,
+        head_hidden: torch.Tensor,
+        num_reqs: int,
+    ) -> torch.Tensor:
+        """Advance the rnn state over the block slot that serving never samples.
+
+        Training (``core.py`` -> ``MarkovHead.block_bias``) runs the recurrent
+        state over ALL ``block_size`` slots, starting from zero at slot 0. With
+        ``sample_from_anchor=False`` slot 0 is the anchor, whose prediction is
+        the bonus token the verifier already produced, so vLLM samples only
+        slots 1..N. Without this step, served slot 1 would run with a zero
+        state instead of slot 0's output, and EVERY served position would see a
+        state one recurrence behind the one it was trained with.
+
+        Training's shifted conditioning gives slot 0 and slot 1 the same
+        previous token (the anchor), so the priming step reuses
+        ``anchor_tokens`` and the anchor slot's backbone hidden, and discards
+        the bias it produces.
+
+        With ``sample_from_anchor=True`` there is no unsampled slot -- served
+        step 0 IS training slot 0 -- so the zero state is already correct.
+        """
+        if self.sample_from_anchor:
+            return state
+        anchor_hidden = head_hidden[self._anchor_idx[:num_reqs]]
+        state, _ = self.model.markov_rnn_step(
+            state, self.model.markov_embed(anchor_tokens), anchor_hidden
+        )
+        return state
